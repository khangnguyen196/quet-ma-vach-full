# Máy chủ OCR: tên biến + mặc định. KHÔNG có bí mật nào. Đặt bằng biến môi trường, hoặc chép thành server/.env
# (chay-thu.ps1 tự đọc server/.env, chỉ đặt biến chưa có; server/.env nằm trong .gitignore, không commit).
OCR_THREADS=8
OCR_OFFLINE=0
MAX_BYTES=5242880
MAX_PIXELS=50000000
MAX_PIXELS_PROGRESSIVE=40000000
RATE_LIMIT_PER_MIN=20
RATE_LIMIT_MAX_IPS=10000
MAX_CONCURRENT=1
QUEUE_MAX=4
BODY_TIMEOUT_S=30
TRUST_PROXY=0
PROXY_COUNT=1
# off = cho qua (chạy thử); supabase = POST /ocr phải có "Authorization: Bearer <token đăng nhập Supabase>"
# (máy chủ đọc thiếu biến thì coi là off; ảnh Docker đặt sẵn AUTH_MODE=supabase)
AUTH_MODE=off
# Chỉ dùng khi AUTH_MODE=supabase (thiếu 1 trong 2 thì máy chủ không khởi động).
# SUPABASE_URL: Project URL dạng https://<ref>.supabase.co
# SUPABASE_PUBLISHABLE_KEY: publishable key là khóa CÔNG KHAI (app trên trình duyệt cũng có);
# KHÔNG dùng JWT secret / service_role (máy chủ không bao giờ cần, không đọc).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# lượt /ocr mỗi người dùng trong 60 giây (cộng thêm với giới hạn theo IP), số người dùng tối đa giữ trong RAM
RATE_LIMIT_USER_PER_MIN=10
RATE_LIMIT_MAX_USERS=10000
# ảnh mỗi người dùng mỗi ngày UTC (chỉ khi AUTH_MODE=supabase; 0 = tắt). Đếm trong RAM: máy chủ ngủ / khởi động lại thì về 0
DAILY_LIMIT_PER_USER=200
# nguồn (trang web) được gọi máy chủ, cách nhau dấu phẩy, dạng https://tên-miền[:cổng], không "/" cuối, không "*".
# Để trống = chỉ https://khangnguyen196.github.io. Đặt giá trị thì THAY mặc định (muốn giữ github.io thì ghi vào danh sách).
ALLOWED_ORIGINS=
# 1 = cho thêm http(s)://localhost / 127.0.0.1 (mọi cổng), CỘNG thêm với ALLOWED_ORIGINS (chay-thu.ps1 luôn đặt 1)
CORS_ALLOW_LOCALHOST=0
# cổng máy chủ lắng nghe TRONG Docker (Dockerfile đọc PORT; chay-thu.ps1 dùng tham số -Port, mặc định 8765)
PORT=8080
