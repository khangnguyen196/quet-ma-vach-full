# Máy chủ OCR: tên biến + mặc định. KHÔNG có bí mật nào. Đặt bằng biến môi trường (chay-thu.ps1 đặt sẵn khi chạy thử).
OCR_THREADS=8
OCR_OFFLINE=0
MAX_BYTES=5242880
MAX_PIXELS=50000000
MAX_PIXELS_PROGRESSIVE=40000000
RATE_LIMIT_PER_MIN=20
RATE_LIMIT_MAX_IPS=10000
MAX_CONCURRENT=1
QUEUE_MAX=4
BODY_TIMEOUT_S=30
TRUST_PROXY=0
PROXY_COUNT=1
AUTH_MODE=off
CORS_ALLOW_LOCALHOST=0
