# Copy thành .env. Thiếu key nào thì công cụ đó bị bỏ qua.

# Tesseract: chỉ cần nếu Windows không tìm thấy tesseract.exe
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Google Cloud Vision: đường dẫn file JSON của service account
# GOOGLE_APPLICATION_CREDENTIALS=C:\keys\google-vision.json

# Azure AI Vision
# AZURE_VISION_ENDPOINT=https://<ten-resource>.cognitiveservices.azure.com/
# AZURE_VISION_KEY=

# Claude API: KHÔNG DÙNG trong dự án này (không có mức miễn phí, không gọi API Claude / Anthropic).
# Không điền ANTHROPIC_API_KEY. Công cụ "claude" đã bị gỡ khỏi script.

# Phần B – extractor "llm": chỉ chạy bằng model trên máy qua Ollama (miễn phí, không gọi Anthropic API)
LLM_PROVIDER=ollama
# OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_TIMEOUT=180
