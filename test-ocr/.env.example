# Copy thành .env. Thiếu key nào thì công cụ đó bị bỏ qua.

# Tesseract: chỉ cần nếu Windows không tìm thấy tesseract.exe
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Google Cloud Vision: đường dẫn file JSON của service account
# GOOGLE_APPLICATION_CREDENTIALS=C:\keys\google-vision.json

# Azure AI Vision
# AZURE_VISION_ENDPOINT=https://<ten-resource>.cognitiveservices.azure.com/
# AZURE_VISION_KEY=

# Claude API
# ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# Phần B – extractor "llm": dùng Claude (mặc định) hoặc model chạy trên máy qua Ollama (miễn phí)
LLM_PROVIDER=claude
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=qwen2.5:7b
