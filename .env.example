# Copy file này thành .env rồi sửa nếu cần. Vite chỉ đọc biến bắt đầu bằng VITE_
# .env đã nằm trong .gitignore, không commit.

# Địa chỉ API Open Food Facts (không cần key)
VITE_OFF_API=https://world.openfoodfacts.org/api/v2

# Tên app hiện trên giao diện
VITE_APP_NAME=Quét mã vạch đồ ăn

# Đăng nhập Google qua Supabase (không bắt buộc; thiếu 1 trong 2 biến thì app ẩn nút đăng nhập).
# VITE_SUPABASE_URL: Project URL dạng https://<ref>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY: publishable key là khóa CÔNG KHAI (nằm trong app trên trình duyệt),
# KHÔNG phải secret / service_role. Không bao giờ điền JWT secret hay service_role key vào đây.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Địa chỉ máy chủ OCR, vd https://<app>.azurecontainerapps.io; chỉ dùng khi npm run dev
# (khu "Thử máy chủ OCR"; để trống = http://127.0.0.1:8765 của server\chay-thu.ps1; tên cũ VITE_OCR_DEV_URL vẫn đọc được)
VITE_OCR_SERVER_URL=

# Không dùng API Claude / Anthropic (xem .claude/du-an.md)
